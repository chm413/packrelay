# 统一按 LF 入库：workflow 里的 run: 都是 bash 脚本，
# 一旦被提交成 CRLF，Linux runner 会报 "bash: $'\r': command not found"。
* text=auto eol=lf

# Windows 专用脚本保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制，别做行尾转换
*.png  binary
*.jpg  binary
*.ogg  binary
*.zip  binary
*.dll  binary
*.lib  binary
*.pdb  binary
*.exe  binary
